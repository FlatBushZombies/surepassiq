# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# skills tool: symlinks into .agents/skills use absolute, machine-specific
# paths and won't resolve on another machine. Re-run `npx skills add` (or
# the tool's sync command) locally to regenerate them from skills-lock.json.
.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts
